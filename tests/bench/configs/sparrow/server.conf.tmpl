# Конфиг Nano-Sparrow для бенчмарка. 1 подставляется
# runner'ом (tests/bench/bench/run_bench.py) при пересоздании сервисов.
[server]
port = 8080
worker_threads = 1
max_connections = __MAX_CONNECTIONS__
buffer_size = 8192
io_timeout_ms = 30000
enable_sqpoll = false
enable_affinity = false
enable_gzip = true
enable_keep_alive = true

[ssl]
enable_ssl = false

# Только IPv4-литерал: sparrow резолвит бэкенд через inet_pton (без DNS).
# Статический IP backend'а закреплён в docker-compose.yml (172.30.0.10).
[upstream:api]
node = 172.30.0.10:9090

[routes]
/status = status
/big = big
/echo = echo
/static/ = static:/www
/api = proxy:api
